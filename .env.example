# Copy this file to ".env" and fill in your real keys.
# The real ".env" is ignored by Git. Never commit it.

# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# https://aqicn.org/data-platform/token/
AQICN_API_TOKEN=

# https://docs.openaq.org (free API key for the v3 API)
OPENAQ_API_KEY=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
